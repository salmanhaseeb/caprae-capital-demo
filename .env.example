# Local Linux helper defaults. Never use these local trust connections in production.
# npm run dev starts persistent PostgreSQL when these exact local URLs are used.
DATABASE_URL="postgresql://search_memory_app@localhost:55439/search_memory?host=/tmp/search-memory-pg-socket"
DIRECT_URL="postgresql://postgres@localhost:55439/search_memory?host=/tmp/search-memory-pg-socket"

# Neon production: replace DATABASE_URL with the pooled TLS URL for a restricted,
# non-owner role. DIRECT_URL is the direct admin URL for migrations/seed only;
# keep it in your release environment, not the deployed application's environment.
# URL shapes only (replace all placeholders; URL-encode passwords):
# DATABASE_URL="postgresql://search_memory_app:ENCODED_PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://neondb_owner:ENCODED_PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Public fictional identity switcher; this is not real authentication.
DEMO_MODE="true"
# Required for production builds/runtime: generate a unique random secret (32+ chars).
DEMO_SESSION_SECRET=""

# Optional, server-only. Without a key, raw notes still save but AI analysis is unavailable.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional repeatable seed reference date (YYYY-MM-DD); defaults to today's UTC date.
# SEED_REFERENCE_DATE="2026-09-21"
# Set ALLOW_DEMO_SEED=true only for an intentional production demo seed operation.
# Never enable TEST_AI_FIXTURE or OPENAI_BASE_URL in production.
