# Runtime: pooled Neon URL for a non-owner role without SUPERUSER/BYPASSRLS.
DATABASE_URL="postgresql://search_memory_app:password@localhost:5432/search_memory"
# Migration/admin role only; never use this connection for application requests.
DIRECT_URL="postgresql://search_memory_admin:password@localhost:5432/search_memory"
# Optional seed date (YYYY-MM-DD); defaults to today's UTC date on first insertion.
# SEED_REFERENCE_DATE="2026-09-17"
# Explicitly enable the public, fictional demo identities. Not production authentication.
DEMO_MODE="true"
# Required in production: generate a random secret of at least 32 characters.
# Local development uses a development-only fallback when this is empty.
DEMO_SESSION_SECRET=""

# Server-only OpenAI credentials for interaction analysis.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
