{
  "name": "search-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "dev": "next dev",
    "build": "next build --webpack",
    "heroku-postbuild": "npm run build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "prebuild": "npm run check:env && prisma generate",
    "predev": "npm run db:local",
    "db:local": "node scripts/local-database.mjs",
    "check:env": "node scripts/check-env.mjs --production",
    "db:check": "node scripts/check-database.mjs",
    "check": "npm run db:generate && npm run db:validate && npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "dotenv": "17.4.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "openai": "^6.49.0",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prisma": "7.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
